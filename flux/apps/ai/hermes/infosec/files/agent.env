A2A_AGENT_NAME=Infosec Engineer
A2A_AGENT_DESCRIPTION=Security review of pull requests; authors Kyverno/StackRox policy PRs; monitors cluster security findings.
A2A_PUBLIC_URL=http://hermes.hermes-infosec.svc.cluster.local:9900
# Identity slug for the shared gh-pr.py default PR body
GH_AGENT_SLUG=infosec-engineer
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=${AI_HERMES_INFOSEC_DASHBOARD_BASIC_AUTH_USERNAME}
# GitHub App (infosec-engineer's own App; opened 2026-11-02)
# App/Installation IDs are public identifiers (not credentials) so they are
# hardcoded here: ${VAR}-substituted values are re-parsed as YAML and bare
# numbers become ints, breaking the ConfigMap/Secret typed patch. Env-file
# literals survive kustomize's string-typed marshaling.
GH_APP_ID=5585132
GH_APP_INSTALLATION_ID=177952586
GH_SECURITY_STATE=/opt/data/.work/gh-review-state.json
# StackRox Central REST API (in-cluster, self-signed TLS: callers use curl -k)
STACKROX_API_URL=https://central.stackrox.svc.cluster.local:443
# Mattermost (outbound alerts + home channel; token in agent-secrets).
# Previously unconfigured for this agent — seeded now, same home channel as
# the other agents.
MATTERMOST_URL=http://mattermost.mattermost.svc.cluster.local:8065
MATTERMOST_ALLOWED_USERS=zmbm98kjjtbqxpq6ybskxkbsyy
MATTERMOST_HOME_CHANNEL=ibtjq4s913fx8fzuddmnido7yr
