A2A_AGENT_NAME=Platform Engineer
A2A_AGENT_DESCRIPTION=Implements approved GitOps plans; opens PR, alerts Mattermost.
A2A_PUBLIC_URL=http://hermes.hermes-platform-engineer.svc.cluster.local:9900
# Identity slug for the shared gh-pr.py default PR body
GH_AGENT_SLUG=platform-engineer
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=${AI_HERMES_PLATFORM_ENGINEER_DASHBOARD_BASIC_AUTH_USERNAME}
# GitHub App (platform-engineer's own App; branch push + PR publishing)
# App/Installation IDs are public identifiers (not credentials) so they are
# hardcoded here: envsubst-substituted values are re-parsed as YAML and bare
# numbers would become ints, breaking the ConfigMap.
GH_APP_ID=5217725
GH_APP_INSTALLATION_ID=168687613
# Mattermost (outbound alerts + home channel; token in agent-secrets)
MATTERMOST_URL=http://mattermost.mattermost.svc.cluster.local:8065
MATTERMOST_ALLOWED_USERS=zmbm98kjjtbqxpq6ybskxkbsyy
MATTERMOST_HOME_CHANNEL=ibtjq4s913fx8fzuddmnido7yr
