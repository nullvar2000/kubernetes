# Shared env for every hermes agent overlay (identity env lives in the
# per-overlay files/agent.env, merged into the same agent-env ConfigMap).
PATH=/opt/hermes/.venv/bin:/opt/data/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
HOME=/opt/data
HERMES_HOME=/opt/data
HERMES_TIMEZONE=${GLOBAL_TZ}
# Dashboard enabled for all agents (basic auth; password in agent-secrets)
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
# A2A inbound platform (LiteLLM agent gateway); the bearer (A2A_PEER_TOKENS)
# is composed in the agent-secrets Secret.
A2A_HOST=0.0.0.0
A2A_PORT=9900
A2A_TRUSTED_PEERS=litellm
A2A_REPLY_TIMEOUT=1800
# Git: tolerate the PVC-owned repo directory when running as root
GIT_CONFIG_COUNT=2
GIT_CONFIG_KEY_0=safe.directory
GIT_CONFIG_VALUE_0=/opt/data
GIT_CONFIG_KEY_1=safe.directory
GIT_CONFIG_VALUE_1=/opt/data/k8s-repo
GH_PR_REPO=nullvar2000/kubernetes
GH_WORKDIR=/opt/data/k8s-repo
