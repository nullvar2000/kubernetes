# Seeded by seed.sh on first boot (copy, no substitution). Edit in-place inside
# the pod (or via the hermes CLI), not in git — this file is only the first-boot
# template. Shape mirrors the WORKING hermes-agent home (verified 2026-11-03):
# the providers-dict form from current docs is dropped by this image's config
# init; the legacy custom_providers list with key_env is what survives.
# The key itself travels via env (agent-secrets Secret -> LITELLM_API_KEY);
# key_env references its name, so no secret ever lands in git or on the PVC config.
model:
  default: qwen3.8-flash-next
  provider: litellm-local
  context_length: 262144
custom_providers:
  - name: litellm-local
    base_url: http://litellm.litellm.svc.cluster.local:4000/v1
    key_env: LITELLM_API_KEY
    model: qwen3.8-flash-next
    models:
      qwen3.8-27b:
        context_length: 262144
      qwen3.8-flash-next:
        context_length: 262144

# LiteLLM MCP gateway (mcp_servers in litellm's config.yaml) exposes each
# upstream at /mcp/<server_name> on streamable HTTP (verified 2026-11-03).
# Auth is the agent's own LITELLM_API_KEY, resolved by HERMES from the process
# env (agent-secrets envFrom). The ${env:VAR} form is Hermes' expansion
# syntax; this file only reaches the cluster intact because the agent-files
# ConfigMap carries the annotation kustomize.toolkit.fluxcd.io/substitute:
# disabled (see ../kustomization.yaml). Without that annotation, Flux's
# non-strict postBuild envsub blanks EVERY ${...} here — verified broken in
# the live ConfigMaps on 2026-11-12. Do not reintroduce bare ${VAR} either,
# in case the annotation is ever dropped: a same-named apps-secrets key
# would then be baked in verbatim.
# comfyui is intentionally omitted (irrelevant to agent work).
# kubernetes MCP is intentionally absent: agents reach the cluster via the
# in-pod kubectl (ClusterRole hermes-<agent>-read) instead of a cluster-wide
# MCP server. fastcrw is the agent's only gateway MCP.
mcp_servers:
  fastcrw:
    url: http://litellm.litellm.svc.cluster.local:4000/mcp/fastcrw
    headers:
      Authorization: "Bearer ${env:LITELLM_API_KEY}"

# Promoted from the live platform-engineer home config (git-canonical now):
# toolsets, workdir, search backend, approval posture, secret redaction, and
# the A2A gateway listener.
toolsets:
  - hermes-cli
  - file
  - session-search
  - skills
  - mattermost
terminal:
  cwd: /opt/data/k8s-repo
web:
  backend: searxng
approvals:
  mode: smart
  cron_mode: deny
security:
  redact_secrets: true
gateway:
  platforms:
    a2a:
      enabled: true
      extra:
        port: 9900
