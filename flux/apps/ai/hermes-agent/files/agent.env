# HOME=/opt/data
PATH=/opt/hermes/.venv/bin:/opt/data/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# HERMES_HOME=/opt/data
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=${AI_HERMES_DASHBOARD_BASIC_AUTH_USERNAME}
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=${AI_HERMES_DASHBOARD_BASIC_AUTH_PASSWORD}
HERMES_TIMEZONE=${GLOBAL_TZ}
# A2A inbound platform (LiteLLM agent gateway -> platform-engineer profile)
A2A_HOST=0.0.0.0
A2A_PORT=9900
A2A_PEER_TOKENS=litellm:${AI_HERMES_A2A_TOKEN}
A2A_TRUSTED_PEERS=litellm
A2A_AGENT_NAME=Platform Engineer
A2A_AGENT_DESCRIPTION=Implements approved GitOps plans; opens PR, alerts Mattermost.
A2A_PUBLIC_URL=http://hermes-agent.hermes-agent.svc.cluster.local:9900
A2A_REPLY_TIMEOUT=1800
# Git: tolerate the PVC-owned repo directory when running as root
GIT_CONFIG_COUNT=1
GIT_CONFIG_KEY_0=safe.directory
GIT_CONFIG_VALUE_0=/opt/data/k8s-repo
# GitHub App (platform-engineer branch push + PR publishing)
# App/Installation IDs are public identifiers (not credentials) so they are
# hardcoded here: envsubst-substituted values are re-parsed as YAML and bare
# numbers would become ints, breaking the ConfigMap.
GH_APP_ID=5217725
GH_APP_INSTALLATION_ID=168687613
GH_APP_PRIVATE_KEY_B64=${AI_HERMES_GITHUB_APP_PRIVATE_KEY_B64}
GH_PR_REPO=nullvar2000/kubernetes
# LiteLLM model key (profile -> qwen3.8-27b)
LITELLM_API_KEY=${AI_HERMES_LITELLM_API_KEY}
