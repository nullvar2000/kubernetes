PATH=/opt/hermes/.venv/bin:/opt/data/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Dashboard deliberately disabled (it defaults off; the platform engineer's
# HERMES_DASHBOARD=1 line is intentionally NOT replicated here). First-boot
# setup happens via the hermes CLI in the code-server terminal instead.
HERMES_TIMEZONE=${GLOBAL_TZ}
# A2A inbound platform (LiteLLM agent gateway -> infosec-engineer).
# The bearer (A2A_PEER_TOKENS) is composed in the agent-secrets Secret.
A2A_HOST=0.0.0.0
A2A_PORT=9900
A2A_TRUSTED_PEERS=litellm
A2A_AGENT_NAME=Infosec Engineer
A2A_AGENT_DESCRIPTION=Security review of pull requests; authors Kyverno/StackRox policy PRs; monitors cluster security findings.
A2A_PUBLIC_URL=http://hermes-infosec.hermes-infosec.svc.cluster.local:9900
A2A_REPLY_TIMEOUT=1800
# Git: tolerate the PVC-owned repo directory when running as root
GIT_CONFIG_COUNT=1
GIT_CONFIG_KEY_0=safe.directory
GIT_CONFIG_VALUE_0=/opt/data/k8s-repo
# GitHub App non-secret wiring. App/Installation IDs are public identifiers
# but ride as ${VAR} stringData in agent-secrets: they do not exist until the
# App is created, and bare numeric literals here would be parsed as YAML ints.
GH_PR_REPO=nullvar2000/kubernetes
GH_WORKDIR=/opt/data/k8s-repo
GH_SECURITY_STATE=/opt/data/.work/gh-review-state.json
# StackRox Central REST API (in-cluster, self-signed TLS: callers use curl -k)
STACKROX_API_URL=https://central.stackrox.svc.cluster.local:443
